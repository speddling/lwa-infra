#cloud-config
# Cloud-init configuration for construct VM
# Generated by Ansible on {{ ansible_date_time.iso8601 }}

hostname: {{ construct_hostname }}
fqdn: {{ construct_hostname }}.littlewolfacres.com
manage_etc_hosts: true

users:
  - name: {{ construct_user }}
    groups: sudo
    shell: /bin/bash
    sudo: ['ALL=(ALL) NOPASSWD:ALL']
    lock_passwd: true
    ssh_authorized_keys:
      - {{ ssh_public_key_construct }}

ssh_pwauth: false

# Package installation moved to runcmd with retry logic
# to avoid race conditions with network initialization

# --- Snippet files written via write_files (avoids YAML heredoc indentation issues) ---
write_files:
  - path: /tmp/nvm-bashrc.conf
    content: |
      # nvm
      unset npm_config_prefix
      export NVM_DIR="$HOME/.nvm"
      [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
      [ -s "$NVM_DIR/bash_completion" ] && . "$NVM_DIR/bash_completion"

  - path: /tmp/nvm-profile.conf
    content: |
      # nvm
      unset npm_config_prefix
      export NVM_DIR="$HOME/.nvm"
      [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"

  - path: /tmp/setup-dev-tools.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -e

      # Install GitHub CLI
      curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | \
        sudo dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg
      sudo chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg
      echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] \
        https://cli.github.com/packages stable main" | \
        sudo tee /etc/apt/sources.list.d/github-cli.list > /dev/null
      sudo apt-get update -qq
      sudo apt-get install -y gh

      # Install NVM for user and Node.js 22
      # Debian 12 ships Node 18, but pi-coding-agent requires Node 22+
      # (they use the regex 'v' flag / crypto.hash API only available in Node 22+).
      sudo -u {{ construct_user }} bash -c 'curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.0/install.sh | bash'

      # Install Node.js 22 and set as default
      sudo -u {{ construct_user }} bash -c '
        export NVM_DIR="$HOME/.nvm"
        [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
        nvm install 22
        nvm alias default 22
        nvm use default
      '

      # Ensure nvm loads in interactive AND non-interactive shells.
      # N.B.: Debian 12 system npm sets npm_config_prefix=/usr/local, which
      # breaks nvm ("nvm is not compatible with npm_config_prefix"). We unset it
      # before loading nvm so Node 22 is used instead of system Node 18.
      # .bashrc is sourced by interactive non-login bash (tmux, PTY sessions).
      # .profile is sourced by login shells (SSH, bash -lc).
      # N.B.: These snippet files were written by write_files above to avoid
      # YAML heredoc indentation issues (column-0 heredoc content breaks YAML
      # block scalar parsing).
      # Idempotency: grep -q prevents duplicate appends on re-runs.
      grep -q "NVM_DIR" /home/{{ construct_user }}/.bashrc || \
        sudo -u {{ construct_user }} cat /tmp/nvm-bashrc.conf >> /home/{{ construct_user }}/.bashrc
      grep -q "NVM_DIR" /home/{{ construct_user }}/.profile || \
        sudo -u {{ construct_user }} cat /tmp/nvm-profile.conf >> /home/{{ construct_user }}/.profile

      # Install Pi coding agent using nvm Node 22 (NOT system Node 18)
      sudo -u {{ construct_user }} bash -c '
        export NVM_DIR="$HOME/.nvm"
        [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
        nvm use 22
        npm install -g @earendil-works/pi-coding-agent
      '

      # Git config
      sudo -u {{ construct_user }} bash -c '
        git config --global user.name "James Hart"
        git config --global user.email "speddling@gmail.com"
      '

runcmd:
  # Wait for network to be fully ready
  - timeout 60 bash -c 'until ping -c1 archive.ubuntu.com &>/dev/null; do sleep 2; done'

  # Update package lists with retries
  - |
    for i in {1..5}; do
      apt-get update && break
      echo "apt-get update failed, retry $i/5"
      sleep 10
    done

  # Install base packages with retries
  - |
    for i in {1..3}; do
      DEBIAN_FRONTEND=noninteractive apt-get install -y \
        curl wget git vim tmux jq build-essential \
        python3 python3-pip nodejs npm golang \
        htop net-tools ca-certificates gnupg lsb-release \
        && break
      echo "Package installation failed, retry $i/3"
      sleep 10
    done

  - /tmp/setup-dev-tools.sh
  - systemctl enable ssh
  - systemctl restart ssh

timezone: UTC

final_message: |
  Construct VM is ready!
  SSH from the LAN: ssh -p {{ construct_ssh_port }} {{ construct_user }}@monolith.littlewolfacres.com
  DNS uses the QEMU DHCP resolver. No overlay network or browser terminal is installed.
